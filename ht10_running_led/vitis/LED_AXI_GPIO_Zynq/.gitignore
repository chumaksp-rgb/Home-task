# Ignore build output directory
/build
/export

# Ignore object files and dependent files
.o
.d

#Ignore logs folder and log files
/logs
.log

#Ignore lock files
.lock

.bin
.pdi
.vitisWorkspace.json

_ide/logs
_ide/.wsdata

# ---------------------------------------------------------------------------
# Vitis build output. Everything below is regenerated by "Build platform" /
# "Build" and must not be committed: it hid a broken BSP setting once already
# (see the xiltimer section in CLAUDE.md).
#
# The patterns above lack the "*" and therefore match nothing; the ones here
# replace them. Sources of truth that stay in git: *.xsa, vitis-comp.json,
# bsp.yaml, app_component_2/src/, platform_2/zynq_fsbl/*.c|*.h, _ide/launch.json.
# ---------------------------------------------------------------------------

# CMake / Ninja build trees. The trailing "/" only matches a directory that
# exists on disk, so "**" covers entries left over in the index after Vitis
# has already deleted the directory.
build/
libsrc/build_configs/
libsrc/build_configs/**
CMakeFiles/
CMakeFiles/**

# Per-session Vitis journals (the number is the process id)
_ide/workspace_journal_*.py

# Compiled artifacts
*.o
*.obj
*.a
*.d
*.elf
*.elf.size

# CMake / Ninja state
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_log
.ninja_deps
compile_commands.json

# Tool and editor caches
.cache/
.clangd
.compile_commands

# Logs and lock files
*.log
*.lock
*.bin
*.pdi