<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="counter_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="counter_tb" />
            <top_module name="glbl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="106.001 ns"></ZoomEndTime>
      <Cursor1Time time="75.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="340"></NameColumnWidth>
      <ValueColumnWidth column_width="111"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="7" />
   <wave_markers>
      <marker time="452000" label="" />
   </wave_markers>
   <wvobject fp_name="/counter_tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/load" type="logic">
      <obj_property name="ElementShortName">load</obj_property>
      <obj_property name="ObjectShortName">load</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/data_in" type="array">
      <obj_property name="ElementShortName">data_in[3:0]</obj_property>
      <obj_property name="ObjectShortName">data_in[3:0]</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/en" type="logic">
      <obj_property name="ElementShortName">en</obj_property>
      <obj_property name="ObjectShortName">en</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/up_down" type="logic">
      <obj_property name="ElementShortName">up_down</obj_property>
      <obj_property name="ObjectShortName">up_down</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/count" type="array">
      <obj_property name="ElementShortName">count[3:0]</obj_property>
      <obj_property name="ObjectShortName">count[3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="isExpanded"></obj_property>
   </wvobject>
</wave_config>
